# 把 example.com 换成你的真实域名，重新 docker compose up -d 即可自动签发 HTTPS
# 认证中心：登录/注册/管理页都走它
auth.example.com {
	encode zstd gzip
	reverse_proxy auth:8000 {
		# 覆写 X-Forwarded-For 为真实客户端 IP（防伪造 XFF 混入）
		header_up X-Forwarded-For {http.vars.remote_host}
	}
}

# 小站（RP）走标准 OIDC，不再由本项目反代
# 每个小站单独部署，只需在 .env 的 OIDC_CLIENTS 里登记 client
