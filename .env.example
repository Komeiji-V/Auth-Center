# ===== 服务端口 =====
PORT=8000

# ===== PostgreSQL 15（连你已有的实例）=====
DATABASE_URL=postgres://auth_user:CHANGE_ME@127.0.0.1:5432/auth_db

# ===== JWT =====
# 生成方法：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_RANDOM_64_HEX
JWT_EXPIRES=1h

# ===== 注册模式（三个独立开关，可任意组合；管理后台可热切换）=====
# REGISTRATION_INVITE_REQUIRED=true   邀请码注册
# REGISTRATION_EMAIL_VERIFY=true      邮箱验证码（默认开启，防机器人核心手段）
# REGISTRATION_REVIEW_REQUIRED=true   人工审核（注册后需管理员通过）
# 首次启动时写入配置表；之后以管理后台/接口设置为准
REGISTRATION_INVITE_REQUIRED=false
REGISTRATION_EMAIL_VERIFY=true
REGISTRATION_REVIEW_REQUIRED=true

# ===== SMTP 发信（验证码邮件）=====
# SMTP_DEBUG=true 时：不发真信，验证码打印到服务日志，并在响应中返回 debug_code（仅限本地调试）
SMTP_DEBUG=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=认证中心 <no-reply@example.com>

# ===== 邮箱策略（逗号分隔；留空=不限制）=====
# BLOCKED_EMAIL_DOMAINS=mailinator.com,guerrillamail.com

# ===== 验证码发送频率限制（每小时每 IP 次数）=====
REG_CODE_PER_HOUR=3
PROFILE_CODE_PER_HOUR=5

# ===== CORS：放行的小站域名（逗号分隔，逗号后不要带空格）=====
CORS_ORIGINS=http://localhost:8001

# ===== 管理员 TOTP：true=管理员必须绑定 TOTP 才能使用管理接口 =====
ADMIN_TOTP_REQUIRED=true
