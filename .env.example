# ===== 站点设置 =====
SITE_TITLE=认证中心
# 网站图标 URL（可空）
SITE_ICON=
# 登录页背景图 URL（可空；可填随机图 API 地址，如 https://picsum.photos/1920/1080?random）
SITE_BG=
# 注册页背景图 URL（可空；留空则与登录页共用 SITE_BG）
SITE_BG_REGISTER=

# ===== 服务端口 =====
PORT=8000

# ===== PostgreSQL 15（连你已有的实例）=====
DATABASE_URL=postgres://auth_user:CHANGE_ME@127.0.0.1:5432/auth_db

# ===== 会话（HttpOnly cookie）=====
# 会话有效期（天）
SESSION_TTL_DAYS=7
# 生产 HTTPS 必须 true
COOKIE_SECURE=true
# 站点自身 origin，用于 CSRF 的 Origin 校验（如 https://auth.example.com）
SITE_ORIGIN=https://auth.example.com

# ===== 注册模式（三个独立开关，可任意组合；管理后台可热切换）=====
# REGISTRATION_INVITE_REQUIRED=true   邀请码注册
# REGISTRATION_EMAIL_VERIFY=true      邮箱验证码（默认开启，防机器人核心手段）
# REGISTRATION_REVIEW_REQUIRED=true   人工审核（注册后需管理员通过）
# 首次启动时写入配置表；之后以管理后台/接口设置为准
REGISTRATION_INVITE_REQUIRED=false
REGISTRATION_EMAIL_VERIFY=true
REGISTRATION_REVIEW_REQUIRED=true

# ===== SMTP 发信（验证码邮件）=====
# SMTP_DEBUG=true 时：不发真信，验证码打印到服务日志，并在响应中返回 debug_code（仅限本地调试）
SMTP_DEBUG=true
# 587 = STARTTLS（显式 TLS，推荐）；465 = 隐式 TLS（配合 SMTP_SECURE=true）
# 应用层强制 requireTLS：587 场景服务器必须支持 STARTTLS，否则报错不发信（绝不降级明文）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=认证中心 <no-reply@example.com>

# ===== 邮箱策略（逗号分隔；留空=不限制）=====
# BLOCKED_EMAIL_DOMAINS=mailinator.com,guerrillamail.com

# ===== 验证码发送频率限制（每小时每 IP 次数）=====
REG_CODE_PER_HOUR=3
PROFILE_CODE_PER_HOUR=5

# ===== 全局限流（每分钟每 IP 请求数上限）=====
GLOBAL_REQ_PER_MIN=60

# ===== 信任代理网段（逗号分隔；仅信任这些来源的 X-Forwarded-For）=====
# 默认覆盖 Docker 容器网段与回环；自定义网络/独立 nginx 部署时按需调整
# TRUST_PROXY_CIDRS=loopback,172.16.0.0/12,10.0.0.0/8

# ===== CORS：放行的小站域名（逗号分隔，逗号后不要带空格）=====
CORS_ORIGINS=http://localhost:8001

# ===== 管理员 TOTP：true=管理员必须绑定 TOTP 才能使用管理接口 =====
ADMIN_TOTP_REQUIRED=true

# ===== OIDC（OpenID Connect）=====
# 开启后同时提供标准 OIDC 端点（/auth /token /jwks /me /session /interaction）
# 旧的 /api/login 仍然可用，可在过渡期双轨运行
OIDC_ENABLED=false
OIDC_ISSUER=https://auth.你的域名
# OIDC 会话 cookie 签名密钥（必须设置，openssl rand -hex 32）
OIDC_COOKIE_SECRET=
# 生产 HTTPS 必须 true；本地 http 调试才设 false
OIDC_COOKIE_SECURE=true
# 每个小站一个 client，JSON 数组。redirect_uris 必须精确匹配，不要用通配符
OIDC_CLIENTS='[{"client_id":"music","client_secret":"CHANGE_ME","redirect_uris":["https://music.example.com/auth/callback"],"backchannel_logout_uri":"https://music.example.com/auth/backchannel-logout"}]'
# 仅调试用：暴露 POST /oidc-debug/kick/:sub（生产必须 false）
OIDC_DEBUG_KICK=false
